@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="tw:m-0 tw:flex tw:list-none tw:flex-wrap tw:items-center tw:gap-3 tw:p-0">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="tw:text-slate-700 tw:no-underline" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="tw:rounded-lg tw:border tw:border-slate-300 tw:bg-white tw:px-3 tw:py-2 tw:text-sm tw:text-slate-700">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="tw:text-slate-700 tw:no-underline" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="tw:text-slate-700 tw:no-underline" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>
