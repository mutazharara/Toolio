<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Toolio
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Toolio.Web.styles.css"
          asp-append-version="true" />
</head>


<body>

    <!-- ===================================================== -->
    <!-- NAVIGATION -->
    <!-- ===================================================== -->

    <header>

        <nav class="
            navbar
            navbar-expand-lg
            navbar-light
            bg-white
            border-bottom
            shadow-sm">

            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand fw-bold fs-4"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    Toolio

                </a>


                <!-- Mobile menu -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#toolioNavbar"
                        aria-controls="toolioNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="
                    collapse
                    navbar-collapse"
                     id="toolioNavbar">


                    <!-- LEFT NAVIGATION -->
                    <ul class="
                        navbar-nav
                        me-auto
                        mb-2
                        mb-lg-0">


                        <!-- Browse Equipment -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Equipment"
                               asp-action="Browse">

                                Browse Equipment

                            </a>

                        </li>


                        <!-- Logged-in navigation -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- My Rentals -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Bookings"
                                   asp-action="Index">

                                    My Rentals

                                </a>

                            </li>


                            <!-- My Listings -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Equipment"
                                   asp-action="Index">

                                    My Listings

                                </a>

                            </li>


                            <!-- Rental Requests -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Bookings"
                                   asp-action="OwnerRequests">

                                    Rental Requests

                                </a>

                            </li>


                            <!-- Admin -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Categories"
                                       asp-action="Index">

                                        Admin

                                    </a>

                                </li>
                            }
                        }

                    </ul>


                    <!-- RIGHT SIDE LOGIN / PROFILE -->
                    <div class="d-flex align-items-center">

                        <partial name="_LoginPartial" />

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer class="
        border-top
        mt-5
        py-4
        text-muted">

        <div class="
            container
            d-flex
            justify-content-between
            flex-wrap
            gap-2">

            <span>
                &copy; 2026 Toolio
            </span>

            <span>
                Community Equipment Rental Platform
            </span>

        </div>

    </footer>


    <!-- ===================================================== -->
    <!-- SCRIPTS -->
    <!-- ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>