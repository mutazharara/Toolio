<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Toolio</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Toolio.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body class="tw:flex tw:min-h-screen tw:flex-col tw:bg-slate-50 tw:text-slate-900">
    <a href="#main-content" class="visually-hidden-focusable">Skip to content</a>
    <header class="tw:border-b tw:border-slate-200 tw:bg-white">
        <nav aria-label="Main navigation" class="tw:mx-auto tw:flex tw:max-w-6xl tw:flex-wrap tw:items-center tw:justify-between tw:gap-4 tw:px-4 tw:py-4">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="tw:text-2xl tw:font-bold tw:tracking-tight tw:text-emerald-800 tw:no-underline">Toolio<span class="tw:ml-2 tw:text-xs tw:font-normal tw:text-slate-500">Borrow locally.</span></a>
            <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-4 tw:text-sm tw:font-medium">
                <a asp-area="" asp-controller="Equipment" asp-action="Browse" class="tw:text-slate-700 tw:no-underline tw:hover:text-emerald-700">Browse equipment</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Equipment" asp-action="Index" class="tw:text-slate-700 tw:no-underline">My listings</a>
                    <a asp-area="" asp-controller="Bookings" asp-action="Index" class="tw:text-slate-700 tw:no-underline">My rentals</a>
                    <a asp-area="" asp-controller="Bookings" asp-action="OwnerRequests" class="tw:text-slate-700 tw:no-underline">Rental requests</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="" asp-controller="Categories" asp-action="Index" class="tw:text-slate-700 tw:no-underline">Categories</a>
                    }
                }
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <main id="main-content" role="main" class="tw:flex-1">@RenderBody()</main>
    <footer class="tw:mt-10 tw:border-t tw:border-slate-200 tw:bg-white">
        <div class="tw:mx-auto tw:flex tw:max-w-6xl tw:flex-wrap tw:justify-between tw:gap-2 tw:px-4 tw:py-6 tw:text-sm tw:text-slate-500">
            <span>&copy; 2026 Toolio</span><span>Community equipment rental platform</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
