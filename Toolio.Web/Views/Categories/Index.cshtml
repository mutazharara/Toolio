@model IEnumerable<Toolio.Web.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Equipment Categories</h1>
            <p class="text-muted">
                Manage the equipment categories available on Toolio.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-dark">
            + Add Category
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-light border">
            No categories have been created yet.
        </div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Equipment</th>
                    <th class="text-end">
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>
                            <strong>
                                @category.Name
                            </strong>
                        </td>

                        <td>
                            @category.Description
                        </td>

                        <td>
                            @category.Equipment.Count
                        </td>

                        <td class="text-end">

                            <a asp-action="Edit"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-sm btn-outline-dark">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>