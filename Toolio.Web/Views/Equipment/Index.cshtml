@model IEnumerable<Toolio.Web.Models.Equipment>

@{
    ViewData["Title"] = "My Listings";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Listings</h1>
            <p class="text-muted">
                Manage the equipment you have listed on Toolio.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-dark">
            + List Equipment
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="border rounded p-5 text-center">
            <h4>You haven't listed any equipment yet.</h4>

            <p class="text-muted">
                Start earning from tools you are not currently using.
            </p>

            <a asp-action="Create"
               class="btn btn-dark">
                List your first item
            </a>
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100">

                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 style="height:220px; object-fit:cover;"
                                 alt="@item.Name" />
                        }

                        <div class="card-body">

                            <div class="d-flex justify-content-between">
                                <h5 class="card-title">
                                    @item.Name
                                </h5>

                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Unavailable
                                    </span>
                                }
                            </div>

                            <p class="text-muted">
                                @item.Category?.Name
                            </p>

                            <p>
                                <strong>
                                    @item.PricePerDay.ToString("C")
                                </strong>
                                / day
                            </p>

                            <div class="d-flex gap-2">

                                <a asp-action="Edit"
                                   asp-route-id="@item.EquipmentId"
                                   class="btn btn-sm btn-outline-dark">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.EquipmentId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>

                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>