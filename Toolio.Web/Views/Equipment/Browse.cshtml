@model Toolio.Web.ViewModels.EquipmentBrowseViewModel

@{
    ViewData["Title"] = "Browse Equipment";
}

<div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-10">

    <!-- Heading -->
    <div class="tw:mb-8">

        <h1 class="tw:text-3xl tw:font-bold tw:tracking-tight tw:text-slate-900">
            Find the right tool for the job
        </h1>

        <p class="tw:mt-3 tw:text-lg tw:text-slate-600">
            Rent equipment from people in your community.
        </p>

    </div>


    <!-- Search and filters -->
    <form method="get"
          asp-action="Browse"
          class="tw:mb-8 tw:rounded-2xl tw:border tw:border-slate-200 tw:bg-white tw:p-5 tw:shadow-sm">

        <div class="tw:grid tw:gap-4 tw:md:grid-cols-2 tw:lg:grid-cols-12">

            <!-- Search -->
            <div class="tw:lg:col-span-4">

                <label class="tw:mb-2 tw:block tw:text-sm tw:font-semibold tw:text-slate-700">
                    What do you need?
                </label>

                <input type="text"
                       name="search"
                       value="@Model.SearchTerm"
                       class="tw:block tw:w-full tw:rounded-lg tw:border tw:border-slate-300 tw:bg-white tw:px-3 tw:py-3 tw:text-slate-900"
                       placeholder="Drill, ladder, lawn mower..." />

            </div>


            <!-- Category -->
            <div class="tw:lg:col-span-3">

                <label class="tw:mb-2 tw:block tw:text-sm tw:font-semibold tw:text-slate-700">
                    Category
                </label>

                <select name="categoryId"
                        class="tw:block tw:w-full tw:rounded-lg tw:border tw:border-slate-300 tw:bg-white tw:px-3 tw:py-3 tw:text-slate-900">

                    <option value="">
                        All categories
                    </option>

                    @foreach (var category in Model.Categories)
                    {
                        if (Model.CategoryId == category.CategoryId)
                        {
                            <option value="@category.CategoryId"
                                    selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.CategoryId">
                                @category.Name
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Availability -->
            <div class="tw:lg:col-span-3">

                <label class="tw:mb-2 tw:block tw:text-sm tw:font-semibold tw:text-slate-700">
                    Availability
                </label>

                <select name="availability"
                        class="tw:block tw:w-full tw:rounded-lg tw:border tw:border-slate-300 tw:bg-white tw:px-3 tw:py-3 tw:text-slate-900">

                    @if (Model.Availability == "available")
                    {
                        <option value="available" selected>
                            Available
                        </option>

                        <option value="all">
                            All
                        </option>
                    }
                    else
                    {
                        <option value="available">
                            Available
                        </option>

                        <option value="all" selected>
                            All
                        </option>
                    }

                </select>

            </div>


            <!-- Search button -->
            <div class="tw:flex tw:items-end tw:lg:col-span-2">

                <button type="submit"
                        class="tw:w-full tw:rounded-lg tw:border-0 tw:bg-emerald-700 tw:px-4 tw:py-3 tw:font-semibold tw:text-white tw:hover:bg-emerald-800">
                    Search
                </button>

            </div>

        </div>


        <!-- Sorting -->
        <div class="tw:mt-4">

            <div class="tw:max-w-xs">

                <label class="tw:mb-2 tw:block tw:text-sm tw:font-semibold tw:text-slate-700">
                    Sort by
                </label>

                <select name="sort"
                        class="tw:w-full tw:rounded-lg tw:border tw:border-slate-300 tw:bg-white tw:px-3 tw:py-2"
                        onchange="this.form.submit()">

                    <option value="newest"
                            selected="@(Model.Sort == "newest")">
                        Newest
                    </option>

                    <option value="price-low"
                            selected="@(Model.Sort == "price-low")">
                        Price: Low to High
                    </option>

                    <option value="price-high"
                            selected="@(Model.Sort == "price-high")">
                        Price: High to Low
                    </option>

                    <option value="name"
                            selected="@(Model.Sort == "name")">
                        Name
                    </option>

                </select>

            </div>

        </div>

    </form>


    <!-- Results information -->
    <div class="tw:mb-6 tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-3">

        <div>

            <h2 class="tw:mb-1 tw:text-xl tw:font-bold">
                Equipment in your community
            </h2>

            <p class="tw:m-0 tw:text-slate-600">
                @Model.Equipment.Count item(s) found
            </p>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm)
             || Model.CategoryId.HasValue)
        {
            <a asp-action="Browse"
               class="tw:rounded-lg tw:border tw:border-slate-300 tw:bg-white tw:px-4 tw:py-2 tw:text-slate-700 tw:no-underline">
                Clear filters
            </a>
        }

    </div>


    <!-- No results -->
    @if (!Model.Equipment.Any())
    {
        <div class="tw:rounded-2xl tw:border tw:border-dashed tw:border-slate-300 tw:bg-white tw:p-10 tw:text-center">

            <h3 class="tw:text-lg tw:font-semibold">
                No equipment found
            </h3>

            <p class="tw:text-slate-500">
                Try changing your search or filters.
            </p>

            <a asp-action="Browse"
               class="tw:inline-block tw:rounded-lg tw:bg-emerald-700 tw:px-4 tw:py-2 tw:text-white tw:no-underline">
                View all equipment
            </a>

        </div>
    }
    else
    {
        <!-- Equipment Cards -->
        <div class="tw:grid tw:gap-6 tw:sm:grid-cols-2 tw:lg:grid-cols-3">

            @foreach (var item in Model.Equipment)
            {
                <div class="tw:min-w-0">

                    <div class="tw:h-full tw:overflow-hidden tw:rounded-2xl tw:border tw:border-slate-200 tw:bg-white tw:p-4 tw:shadow-sm">

                        <!-- Equipment image -->
                        <a asp-action="Details"
                           asp-route-id="@item.EquipmentId"
                           class="tw:no-underline">

                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.Name"
                                     class="tw:w-full tw:rounded-xl"
                                     style="
                                aspect-ratio:4/3;
                                object-fit:cover;
                                " />
                            }
                            else
                            {
                                <div class="tw:flex tw:items-center tw:justify-center tw:rounded-xl tw:bg-slate-100 tw:text-slate-500"
                                     style="
                                    aspect-ratio:4/3;
                                    ">

                                    Equipment photo

                                </div>
                            }

                        </a>


                        <!-- Equipment details -->
                        <div class="tw:pt-4">

                            <div class="tw:flex tw:justify-between tw:gap-3">

                                <a asp-action="Details"
                                   asp-route-id="@item.EquipmentId"
                                   class="tw:text-slate-900 tw:no-underline">

                                    <h3 class="tw:mb-1 tw:text-lg tw:font-bold">
                                        @item.Name
                                    </h3>

                                </a>

                                @if (item.IsAvailable)
                                {
                                    <span class="tw:rounded-full tw:bg-emerald-50 tw:px-2 tw:py-1 tw:text-xs tw:font-semibold tw:text-emerald-800">

                                        Available

                                    </span>
                                }

                            </div>


                            <p class="tw:mb-2 tw:text-sm tw:text-slate-500">
                                @item.Category?.Name
                            </p>


                            <p class="tw:mb-4">

                                <strong class="tw:text-xl tw:text-slate-900">
                                    @item.PricePerDay.ToString("C")
                                </strong>

                                <span class="tw:text-slate-500">
                                    / day
                                </span>

                            </p>


                            <a asp-action="Details"
                               asp-route-id="@item.EquipmentId"
                               class="tw:block tw:w-full tw:rounded-lg tw:border tw:border-emerald-700 tw:px-4 tw:py-2 tw:text-center tw:font-semibold tw:text-emerald-800 tw:no-underline">

                                View details

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>