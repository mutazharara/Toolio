@model Toolio.Web.Models.Equipment

@{
    ViewData["Title"] = "Delete Equipment";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <h1>Delete listing</h1>

            <div class="alert alert-warning mt-4">
                Are you sure you want to delete
                <strong>@Model.Name</strong>?
            </div>

            <div class="card mb-4">

                <div class="card-body">

                    <h5>
                        @Model.Name
                    </h5>

                    <p class="text-muted">
                        @Model.Category?.Name
                    </p>

                    <p>
                        @Model.Description
                    </p>

                    <strong>
                        @Model.PricePerDay.ToString("C") / day
                    </strong>

                </div>

            </div>

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="EquipmentId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete Listing
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>