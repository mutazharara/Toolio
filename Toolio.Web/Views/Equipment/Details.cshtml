@model Toolio.Web.Models.Equipment

@{
    ViewData["Title"] = Model.Name;
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-4">
        @TempData["Error"]
    </div>
}

<div class="container py-5">

    <!-- Back -->
    <a asp-action="Browse"
       class="text-decoration-none text-dark">

        ← Back to equipment

    </a>


    <div class="row g-5 mt-2">

        <!-- LEFT SIDE -->
        <div class="col-lg-7">

            <!-- Image -->
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="w-100 rounded-4"
                     style="
                        aspect-ratio:4/3;
                        object-fit:cover;
                     " />
            }
            else
            {
                <div class="
                    bg-light
                    rounded-4
                    d-flex
                    align-items-center
                    justify-content-center
                    text-muted"
                     style="
                        aspect-ratio:4/3;
                     ">

                    Equipment photo

                </div>
            }


            <!-- Main info -->
            <div class="mt-4">

                <p class="text-muted mb-2">
                    @Model.Category?.Name
                </p>

                <h1 class="display-6 fw-bold">
                    @Model.Name
                </h1>


                @if (Model.IsAvailable)
                {
                    <span class="badge text-bg-success">
                        Available
                    </span>
                }
                else
                {
                    <span class="badge text-bg-secondary">
                        Currently unavailable
                    </span>
                }


                <hr class="my-4" />


                <h2 class="h4">
                    About this equipment
                </h2>

                <p class="
                    fs-5
                    text-secondary"
                   style="white-space:pre-line;">

                    @Model.Description

                </p>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="col-lg-5">

            <div class="
                border
                rounded-4
                p-4
                shadow-sm"
                 style="
                    position:sticky;
                    top:30px;
                 ">

                <div class="mb-4">

                    <strong class="fs-2">
                        @Model.PricePerDay.ToString("C")
                    </strong>

                    <span class="text-muted">
                        / day
                    </span>

                </div>


                @if (Model.IsAvailable)
                {
                    <div class="
                        alert
                        alert-success">

                        This equipment is available
                        for rent.

                    </div>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Bookings"
                        asp-action="Create"
                        asp-route-equipmentId="@Model.EquipmentId"
                        class="btn btn-dark btn-lg w-100">

                            Request booking

                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                        asp-page="/Account/Login"
                        class="btn btn-dark btn-lg w-100">

                            Log in to request booking

                        </a>
                    }

                    <p class="
                        text-muted
                        small
                        text-center
                        mt-2">

                        Booking will be connected
                        in the next feature.

                    </p>
                }
                else
                {
                    <button class="
                        btn
                        btn-secondary
                        btn-lg
                        w-100"
                            disabled>

                        Currently unavailable

                    </button>
                }


                <hr class="my-4" />


                <div class="
                    d-flex
                    justify-content-between">

                    <span class="text-muted">
                        Category
                    </span>

                    <strong>
                        @Model.Category?.Name
                    </strong>

                </div>


                <div class="
                    d-flex
                    justify-content-between
                    mt-3">

                    <span class="text-muted">
                        Listing ID
                    </span>

                    <span>
                        #@Model.EquipmentId
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>