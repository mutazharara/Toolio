@model Toolio.Web.ViewModels.EquipmentDetailsViewModel

@{
    ViewData["Title"] = Model.Equipment.Name;
}

<div class="container py-5">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["Success"]
        </div>
    }

    <!-- Back -->
    <a asp-action="Browse"
       class="text-decoration-none text-dark">

        ← Back to equipment

    </a>


    <div class="row g-5 mt-2">

        <!-- LEFT SIDE -->
        <div class="col-lg-7">

            <!-- Equipment Image -->
            @if (!string.IsNullOrWhiteSpace(Model.Equipment.ImageUrl))
            {
                <img src="@Model.Equipment.ImageUrl"
                     alt="@Model.Equipment.Name"
                     class="w-100 rounded-4"
                     style="
                        aspect-ratio: 4 / 3;
                        object-fit: cover;
                     " />
            }
            else
            {
                <div class="
                    bg-light
                    rounded-4
                    d-flex
                    align-items-center
                    justify-content-center
                    text-muted"
                     style="
                        aspect-ratio: 4 / 3;
                     ">

                    Equipment photo

                </div>
            }


            <!-- Main Equipment Information -->
            <div class="mt-4">

                <p class="text-muted mb-2">
                    @Model.Equipment.Category?.Name
                </p>

                <h1 class="display-6 fw-bold mb-3">
                    @Model.Equipment.Name
                </h1>


                @if (Model.ReviewCount > 0)
                {
                    <div class="mb-3">

                        <span class="fw-semibold">
                            ★ @Model.AverageRating.ToString("0.0")
                        </span>

                        <span class="text-muted">
                            (@Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s"))
                        </span>

                    </div>
                }


                @if (Model.Equipment.IsAvailable)
                {
                    <span class="badge text-bg-success">
                        Available
                    </span>
                }
                else
                {
                    <span class="badge text-bg-secondary">
                        Currently unavailable
                    </span>
                }


                <hr class="my-4" />


                <!-- Description -->
                <h2 class="h4">
                    About this equipment
                </h2>

                <p class="
                    fs-5
                    text-secondary"
                   style="white-space: pre-line;">

                    @Model.Equipment.Description

                </p>


                <!-- Reviews -->
                <hr class="my-5" />

                <div>

                    <div class="
                        d-flex
                        align-items-center
                        gap-3
                        mb-4">

                        <h2 class="h4 mb-0">
                            Reviews
                        </h2>

                        @if (Model.ReviewCount > 0)
                        {
                            <span class="fw-semibold">

                                ★ @Model.AverageRating.ToString("0.0")

                                (@Model.ReviewCount)

                            </span>
                        }

                    </div>


                    @if (!Model.Reviews.Any())
                    {
                        <div class="
                            border
                            rounded-4
                            p-4">

                            <p class="text-muted mb-0">
                                No reviews yet.
                            </p>

                        </div>
                    }
                    else
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="
                                border-bottom
                                pb-4
                                mb-4">

                                <!-- Stars -->
                                <div class="mb-2">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                ☆
                                            </span>
                                        }
                                    }

                                </div>


                                <!-- Comment -->
                                <p class="mb-2">
                                    @review.Comment
                                </p>


                                <!-- Date -->
                                <small class="text-muted">

                                    @review.CreatedAt.ToString(
                                        "dd MMM yyyy")

                                </small>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="col-lg-5">

            <div class="
                border
                rounded-4
                p-4
                shadow-sm"
                 style="
                    position: sticky;
                    top: 30px;
                 ">

                <!-- Price -->
                <div class="mb-4">

                    <strong class="fs-2">
                        @Model.Equipment.PricePerDay.ToString("C")
                    </strong>

                    <span class="text-muted">
                        / day
                    </span>

                </div>


                <!-- Availability / Booking -->
                @if (Model.Equipment.IsAvailable)
                {
                    <div class="
                        alert
                        alert-success">

                        This equipment is available for rent.

                    </div>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Bookings"
                           asp-action="Create"
                           asp-route-equipmentId="@Model.Equipment.EquipmentId"
                           class="
                               btn
                               btn-dark
                               btn-lg
                               w-100">

                            Request booking

                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="
                               btn
                               btn-dark
                               btn-lg
                               w-100">

                            Log in to request booking

                        </a>
                    }
                }
                else
                {
                    <div class="
                        alert
                        alert-secondary">

                        This equipment is currently unavailable.

                    </div>

                    <button class="
                        btn
                        btn-secondary
                        btn-lg
                        w-100"
                            disabled>

                        Currently unavailable

                    </button>
                }


                <hr class="my-4" />


                <!-- Category -->
                <div class="
                    d-flex
                    justify-content-between">

                    <span class="text-muted">
                        Category
                    </span>

                    <strong>
                        @Model.Equipment.Category?.Name
                    </strong>

                </div>


                <!-- Listing ID -->
                <div class="
                    d-flex
                    justify-content-between
                    mt-3">

                    <span class="text-muted">
                        Listing ID
                    </span>

                    <span>
                        #@Model.Equipment.EquipmentId
                    </span>

                </div>


                <!-- Review Summary -->
                <div class="
                    d-flex
                    justify-content-between
                    mt-3">

                    <span class="text-muted">
                        Rating
                    </span>

                    @if (Model.ReviewCount > 0)
                    {
                        <span>
                            ★ @Model.AverageRating.ToString("0.0")
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            No reviews
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>